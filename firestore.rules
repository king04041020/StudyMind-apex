rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isFounder() { return signedIn() && request.auth.uid == 'REPLACE_WITH_FOUNDER_UID'; }
    function isAdmin() { return signedIn() && request.auth.token.studymindAdmin == true; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'admin', 'studymindAdmin']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'studymindAdmin']);
      allow delete: if false;
      match /{subcollection}/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && subcollection != 'roles';
      }
      // Autorise les sous-collections imbriquées appartenant au même utilisateur
      // (ex. assistantChats/main/messages/{messageId}), sans ouvrir les données d'autrui.
      match /{subcollection}/{nestedPath=**} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && subcollection != 'roles';
      }
    }
    match /adminCandidates/{candidateId} {
      allow read: if isFounder() || isAdmin() || (signedIn() && request.auth.uid == candidateId);
      allow write: if false;
    }
    match /adminAudit/{entryId} {
      allow read: if isFounder();
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
