rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(['role', 'admin', 'studymindAdmin', 'studymindFounder']);
      allow update: if signedIn() && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'admin', 'studymindAdmin', 'studymindFounder']);
      allow delete: if false;

      match /{subcollection}/{documentId} {
        allow read, write: if signedIn() && request.auth.uid == userId
          && subcollection != 'roles';
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
